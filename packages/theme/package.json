{
  "name": "@depthly/theme",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./colors": "./dist/js/colors.ts",
    "./typography": "./dist/js/typography.ts",
    "./spacing": "./dist/js/spacing.ts",
    "./themes/*": "./dist/js/themes/*.ts",
    "./css/depthly.css": "./dist/css/depthly.css",
    "./css/spacing.css": "./dist/css/spacing.css"
  },
  "scripts": {
    "codegen": "bun run scripts/generate-tokens.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@depthly/typescript-config": "workspace:*",
    "style-dictionary": "^5.5.0"
  }
}
