{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "deny": [
      "Bash(git push *)",
      "Edit(**/Generated/**)",
      "Edit(**/*.gen.*)",
      "Edit(**/openapi.json)",
      "Edit(**/openapi.*.json)",
      "Edit(**/*.schema.json)",
      "Edit(**/bun.lock)",
      "Edit(**/bun.lockb)",
      "Edit(**/Package.resolved)",
      "Edit(**/gradle.lockfile)",
      "Edit(**/mise.lock)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/bun.lock)",
      "Read(**/bun.lockb)",
      "Read(**/Package.resolved)",
      "Read(**/gradle.lockfile)",
      "Read(**/.turbo/**)",
      "Read(**/DerivedData/**)",
      "Read(**/build/**)"
    ]
  }
}
