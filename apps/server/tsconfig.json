{
  "extends": "@depthly/typescript-config/base.json",
  "compilerOptions": {
    "types": ["bun", "reflect-metadata"],
    "strict": true,
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "exclude": ["scripts"]
}
