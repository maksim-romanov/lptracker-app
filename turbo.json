{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalPassThroughEnv": ["ANDROID_HOME", "ANDROID_SDK_ROOT", "JAVA_HOME"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "codegen"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", "build/**", "_site/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "lint:fix": {
      "dependsOn": ["^lint:fix"]
    },
    "lint:deps": {},
    "typecheck": {
      "dependsOn": ["^typecheck", "codegen"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:ios": {
      "with": ["server#dev", "tokens-data#dev", "server#css:dev", "server#js:dev"],
      "cache": false,
      "persistent": true
    },
    "dev:android": {
      "with": ["server#dev", "tokens-data#dev", "server#css:dev", "server#js:dev"],
      "cache": false,
      "persistent": true
    },
    "server#css:dev": {
      "cache": false,
      "persistent": true
    },
    "server#js:dev": {
      "cache": false,
      "persistent": true
    },
    "codegen": {
      "env": ["GRAPH_API_KEY"]
    },
    "test": {
      "dependsOn": ["build"]
    },
    "deploy": {
      "dependsOn": ["build", "test"],
      "cache": false
    },
    "docker:up": {
      "cache": false
    },
    "docker:down": {
      "cache": false
    }
  }
}
