{
  "name": "depthly",
  "private": true,
  "scripts": {
    "prepare": "lefthook install",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:ios": "turbo run dev:ios",
    "dev:android": "turbo run dev:android",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "spell": "cspell --no-progress --no-must-find-files \"**\"",
    "codegen": "dotenv -- turbo run codegen --ui=stream",
    "graph:up": "turbo run docker:up --filter=@depthly/subgraph-*",
    "graph:down": "turbo run docker:down --filter=@depthly/subgraph-*",
    "graph:build": "turbo run build --filter=@depthly/subgraph-*",
    "graph:test": "turbo run test --filter=@depthly/subgraph-*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/bun": "^1.3.6",
    "cspell": "^9.0.0",
    "dotenv-cli": "^11.0.0",
    "lefthook": "^2.1.9",
    "turbo": "^2.7.5",
    "typescript": "5.9.2",
    "typescript-language-server": "^5.0.0"
  },
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "apps/*",
    "apps/subgraphs/*",
    "packages/*"
  ],
  "dependencies": {
    "expo": "~55.0.4",
    "react": "19.2.0",
    "react-native": "0.83.2"
  },
  "overrides": {
    "jsbi": "3.2.5"
  },
  "version": "1.0.0"
}
